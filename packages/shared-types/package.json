{
  "name": "@tradeflow/shared-types",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/write-esm-marker.mjs",
    "predev": "node scripts/write-esm-marker.mjs",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
