# Copy to .env and adjust as needed. Never commit .env.

# --- API ---
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=tradeflow
POSTGRES_PASSWORD=tradeflow
POSTGRES_DB=tradeflow
DATABASE_URL=postgresql://tradeflow:tradeflow@localhost:5432/tradeflow?schema=public

# --- Redis (matches docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- Auth (Phase 2) ---
JWT_SECRET=change-me-in-real-env
JWT_EXPIRES_IN=1d

# --- Market simulation (Phase 3) ---
# How often simulated prices move, in ms. Set to 0 to disable the price engine.
MARKET_TICK_MS=3000

# --- Web (Vite needs the VITE_ prefix) ---
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000
