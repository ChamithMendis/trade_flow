{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "@swc/jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@nestjs/jwt|@nestjs/config|@nestjs/passport|@nestjs/schedule|@nestjs/bullmq|@nestjs/bull-shared)/)"
  ],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "testTimeout": 30000,
  "maxWorkers": 1
}
